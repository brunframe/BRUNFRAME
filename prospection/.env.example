# Copiez ce fichier en .env (jamais dans Git) puis complétez.

# Google Places API (New) — clé restreinte à « Places API (New) »
GOOGLE_PLACES_API_KEY=

# Rempli automatiquement par « python init_sheet.py »
PIPELINE_SHEET_ID=

# Compte qui envoie les mails et lit le dossier Envoyés
GMAIL_COMPTE=brunframe@gmail.com
OAUTH_CLIENT_FILE=state/client_secret.json

# Feuilles dont les commerces ne doivent jamais être prospectés automatiquement
# (ID = la partie de l'URL entre /d/ et /edit). Plusieurs : séparés par des virgules.
# Mettre ici l'ID de « Mes appels de 14h ».
FEUILLES_A_EXCLURE=

# Hébergement des maquettes : Cloudflare Pages (offre gratuite)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=brunframe-demo
DEMO_BASE_URL=https://brunframe-demo.pages.dev

# Nombre de clients signés (l'offre « 3 premiers clients » disparaît du script à 3)
CLIENTS_SIGNES=0

# place_id de commerces casher qu'Andy a autorisés PAR ÉCRIT (sinon exclus d'office)
ACCORD_CASHER_PLACE_IDS=

# Garde-fou : appels Places par mois et par type de requête (gratuité Google : 1 000)
PLACES_PLAFOND_MENSUEL=900

# « colonnes » = comme « Mes appels de 14h » (un commerce par colonne) ; « lignes » = un par ligne
APPELS_DISPOSITION=colonnes

# Commande Claude Code (claude -p) et navigateur des captures (vide = celui de Playwright)
CLAUDE_CMD=claude
CHROMIUM_PATH=
